   ============================================================ */
.student-dashboard:after{
  content:"";position:absolute;left:30px;top:-42px;width:150px;height:150px;
  border:1px solid #ffffff22;border-radius:30px;transform:rotate(24deg);
  box-shadow:0 0 0 18px #ffffff08,0 0 0 38px #ffffff05;pointer-events:none;
}
.student-dashboard{padding:clamp(18px,3vw,28px);border-radius:25px}
.student-dashboard h2{font-size:clamp(21px,3vw,28px);line-height:1.4}
.dashboard-stat{min-height:92px;display:flex;flex-direction:column;justify-content:center}
.dashboard-stat span{font-size:13px;color:#edf2ff}
