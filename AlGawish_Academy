function renderGradeDashboard(student){
  const lessons=getLessons().filter(l=>l.grade===currentGrade);
  const records=getProgress().filter(p=>p.studentId===student.id&&lessons.some(l=>l.id===p.lessonId));
  const passed=records.filter(p=>p.score>=50||p.teacherUnlocked).length;
  const scores=records.filter(p=>typeof (p.lastScore??p.score)==="number").map(p=>p.lastScore??p.score);
  const avg=scores.length?Math.round(scores.reduce((a,b)=>a+b,0)/scores.length):null;
  const percent=lessons.length?Math.round((passed/lessons.length)*100):0;
  document.getElementById("dashboardGreeting").textContent=`أهلاً ${student.name}، مستعد تحقق إنجاز جديد؟`;
  document.getElementById("dashLessons").textContent=lessons.length;
  document.getElementById("dashPassed").textContent=passed;
  document.getElementById("dashAverage").textContent=avg===null?"—":avg+"%";
  document.getElementById("dashPercent").textContent=percent+"%";
  document.getElementById("dashProgressBar").style.width=percent+"%";
}
