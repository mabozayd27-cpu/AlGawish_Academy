@media(max-width:650px){.wrap{padding:13px}.hero{padding:24px}.topbar{align-items:flex-start}.brand h2{font-size:16px}.lesson{align-items:flex-start;flex-direction:column}.hero:after{font-size:45px}}

/* إعداد وتصميم محمود أبوزايد: تصميم قسم استفسارات المنصة */
.inquiry-card{
  display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap;
  border:1px solid rgba(49,91,216,.18);
  background:linear-gradient(125deg,rgba(235,243,255,.96),rgba(255,250,235,.96));
}
