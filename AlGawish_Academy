lace-items:center;font-size:22px;font-weight:bold}.row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.between{justify-content:space-between}.field{display:grid;gap:6px;margin:12px 0}.field label{font-weight:bold;font-size:14px}.field input,.field select,.field textarea{width:100%;border:1px solid #d9e0ed;border-radius:11px;padding:11px 12px;background:white;color:var(--ink);outline:none}.field input:focus,.field textarea:focus,.field select:focus{border-color:var(--blue);box-shadow:0 0 0 3px #345bd21a}.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:15px 0}.tab{background:#edf1f8;color:#53627d;padding:9px 15px;border-radius:11px;font-weight:bold}.tab.active{background:var(--navy);color:white}.hidden{display:none!important}.notice{padding:12px 15px;border-radius:12px;background:#fff6df;color:#805b13;margin:12px 0}.notice.error{background:#fff0f0;color:#a62d39}.notice.ok{background:#eaf8f1;color:#126b49}.badge{display:inline-block;border-radius:30px;padding:3px 10px;background:#edf1ff;color:var(--blue);font-size:12px;font-weight:bold}.lesson{display:flex;justify-content:space-between;align-items:center;gap:12px;border-bottom:1px solid var(--line);padding:14px 0}.lesson:last-child{border:0}.lesson.locked{opacity:.65}.progress{height:9px;background:#e9edf5;border-radius:20px;overflow:hidden}.progress span{display:block;height:100%;background:linear-gradient(90deg,var(--blue),#6b8cf2);width:0}.video{width:100%;max-height:500px;background:#10182b;border-radius:15px;margin:12px 0}.question{padding:16px;border:1px solid var(--line);border-radius:15px;margin:13px 0}.option{display:block;padding:9px 11px;border:1px solid var(--line);border-radius:10px;margin:7px 0;cursor:pointer}.option:hover{background:#f5f7ff}.option input{margin-left:8px}.footer{text-align:center;color:var(--muted);padding:30px 10px;font-size:13px}.lang{border:1px solid #dbe2ef;background:white;border-radius:10px;padding:8px 12px}.tablewrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:600px}th,td{text-align:right;padding:11px;border-bottom:1px solid var(--line)}th{background:#f7f8fc}.small{font-size:12px}.dangertext{color:var(--red)}.success{color:var(--green)}.empty{text-align:center;padding:28px;color:var(--muted)}.stat{background:#f7f8fc;border-radius:14px;padding:14px}.stat b{font-size:24px;display:block;color:var(--blue)}
/* إعداد وتصميم محمود أبوزايد: تحسينات بصرية إضافية والوضع الليلي */
body.dark-mode{--bg:#0d1425;--ink:#edf2ff;--muted:#a6b2ca;--white:#151f34;--line:#293651;--shadow:0 14px 40px #0005;background:var(--bg);color:var(--ink)}
body.dark-mode .field input,body.dark-mode .field select,body.dark-mode .field textarea,body.dark-mode .lang{background:#101a2d;color:#edf2ff;border-color:#35425e}
body.dark-mode .tab{background:#202d47;color:#d8e1f5}body.dark-mode .tab.active{background:#5478e8;color:white}
body.dark-mode .stat,body.dark-mode th{background:#1c2941}body.dark-mode .option{border-color:#35425e}body.dark-mode .option:hover{background:#202d47}
.theme-btn{border:1px solid var(--line);background:var(--white);color:var(--ink);border-radius:11px;padding:9px 12px;font-weight:bold}
.feature-card{position:relative;overflow:hidden;min-height:145px;background:linear-gradient(145deg,var(--white),#eaf0ff)}
