/* إعداد وتصميم محمود أبوزايد: ألوان التصحيح الفوري وقفل الإجابات */
.option.answer-correct{background:#dcfce7!important;border:2px solid #16a34a!important;color:#14532d!important}
.option.answer-wrong{background:#fee2e2!important;border:2px solid #dc2626!important;color:#7f1d1d!important}
.option input:disabled{cursor:not-allowed}
.answer-feedback{font-weight:700;margin:10px 0 6px;padding:8px 12px;border-radius:10px}
.feedback-correct{background:#dcfce7;color:#166534}
.feedback-wrong{background:#fee2e2;color:#991b1b}
.exam-result-content{text-align:center;padding:12px}
.result-icon{font-size:48px}
.result-score{font-size:48px;font-weight:900;color:var(--primary);margin:10px}
#examFinalResult{margin-top:18px;border:2px solid var(--gold)}
#submitExamBtn:disabled{opacity:.55;cursor:not-allowed}


/* ============================================================
   إعداد وتصميم محمود أبوزايد
   تطوير بصري وتجربة استخدام محسّنة لمنصة AlGawish Academy
   ============================================================ */
:root{
  --blue:#315bd8;--blue2:#6488f4;--gold:#f4c45e;
  --glow:0 18px 55px rgba(42,82,180,.16);
}
body{
  background:
    radial-gradient(circle at 8% 12%,rgba(89,133,245,.10),transparent 24rem),
    radial-gradient(circle at 92% 42%,rgba(245,195,91,.12),transparent 22rem),
    var(--bg);
  transition:background .25s ease,color .25s ease;
}
.hero{
  isolation:isolate;
  background:linear-gradient(125deg,#101c38 0%,#263f83 58%,#4773d8 100%);
}
.hero:before{
  content:"";position:absolute;z-index:-1;width:260px;height:260px;border-radius:50%;
  border:1px solid #ffffff24;right:-80px;top:-110px;
  box-shadow:0 0 0 28px #ffffff09,0 0 0 58px #ffffff06;
}
.hero:after{pointer-events:none}
.card,.grade,.feature-card{transition:transform .22s ease,box-shadow .22s ease,border-color .22s ease}
.card:hover{box-shadow:var(--glow)}
.grade:hover,.feature-card:hover{transform:translateY(-5px);box-shadow:var(--glow)}
.btn,.tab,.theme-btn,.lang{transition:transform .18s ease,filter .18s ease,background .18s ease}
.btn:hover,.tab:hover{transform:translateY(-2px)}
.logo{box-shadow:0 8px 22px #315bd844;position:relative}
.logo:after{content:"";position:absolute;inset:-5px;border:1px solid #315bd833;border-radius:19px}
.grade .n{background:linear-gradient(135deg,#edf2ff,#dce6ff);box-shadow:inset 0 1px #fff}
.teacher-profile{background:linear-gradient(145deg,var(--white),#fffaf0)}
.encouragement .stat{border:1px solid #e7edfb;background:linear-gradient(145deg,#fff,#f4f7ff)}
body.dark-mode .teacher-profile{background:linear-gradient(145deg,#17233a,#28283a)}
body.dark-mode .encouragement .stat{background:linear-gradient(145deg,#1c2941,#202f4c);border-color:#34425e}
.student-dashboard{
  margin:18px 0;padding:20px;border-radius:22px;color:#fff;
  background:linear-gradient(115deg,#18294f,#345bd2 72%,#6688ed);
  position:relative;overflow:hidden;box-shadow:0 16px 38px #244aa52b;
}
.student-dashboard:after{
  content:"";position:absolute;left:24px;top:-34px;width:170px;height:170px;
  border:1px solid #ffffff20;border-radius:34px;transform:rotate(22deg);
  box-shadow:0 0 0 18px #ffffff08,0 0 0 38px #ffffff05;
}
.dashboard-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:15px;position:relative;z-index:1}
.dashboard-stat{padding:12px 14px;border:1px solid #ffffff25;background:#ffffff12;border-radius:15px;backdrop-filter:blur(8px)}
.dashboard-stat b{font-size:25px;display:block;color:#ffdc8a}
.dashboard-progress{height:9px;border-radius:20px;background:#ffffff2b;overflow:hidden;margin-top:13px}
.dashboard-progress span{display:block;height:100%;background:linear-gradient(90deg,#f4c45e,#fff0b8);border-radius:20px}
.lesson-tools{display:flex;gap:9px;flex-wrap:wrap;margin:16px 0}
.lesson-tools input{flex:1;min-width:190px;border:1px solid var(--line);border-radius:12px;padding:11px 13px;background:var(--white);color:var(--ink)}
.lesson-filter{background:#edf1fa;color:#52617d;padding:8px 13px;border-radius:10px;font-weight:bold}
.lesson-filter.active{background:var(--navy);color:#fff}
body.dark-mode .lesson-filter{background:#202d47;color:#d8e1f5}
body.dark-mode .lesson-filter.active{background:#5478e8;color:#fff}
.pill-row{display:flex;gap:8px;flex-wrap:wrap}
.mini-tag{font-size:12px;padding:4px 9px;border-radius:30px;background:#edf2ff;color:#315bd8;font-weight:bold}
body.dark-mode .mini-tag{background:#26395f;color:#cbd8ff}
@media(max-width:650px){
  .dashboard-grid{grid-template-columns:1fr 1fr}
  .student-dashboard{padding:16px}
  .dashboard-stat:last-child{grid-column:1/-1}
}
@media(prefers-reduced-motion:reduce){
  *,*:before,*:after{scroll-behavior:auto!important;transition:none!important;animation:none!important}
}


/* ============================================================
   إعداد وتصميم محمود أبوزايد - تبسيط الواجهة وتطوير لوحة المعلم
