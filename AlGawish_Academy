  background:linear-gradient(125deg,#172943,#302a1d);
  border-color:rgba(125,157,255,.28);
}
.inquiry-copy{flex:1;min-width:220px}
.inquiry-copy h2{margin:9px 0 5px}
.inquiry-btn{white-space:normal;text-align:center;min-width:235px}
.inquiry-card small{width:100%}
