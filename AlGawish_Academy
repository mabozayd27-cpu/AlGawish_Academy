  try{
    const grade=document.getElementById("newGrade").value;
    const title=document.getElementById("newLessonTitle").value.trim();
    const description=document.getElementById("newLessonDesc").value.trim();
    const file=document.getElementById("newLessonVideo").files[0];
    if(!title||!file){setMessage("lessonAdminMessage","اكتب عنوان الدرس واختر ملف فيديو.","error");return}
    if(!file.type.startsWith("video/")){setMessage("lessonAdminMessage","الملف المختار ليس فيديو.","error");return}
    const id=uid();await saveVideo(file,id);
    const lessons=getLessons();lessons.push({id,grade,title,description,order:lessons.filter(l=>l.grade===grade).length+1,createdAt:new Date().toISOString()});writeDB(DB_KEYS.lessons,lessons);
    document.getElementById("newLessonTitle").value="";document.getElementById("newLessonDesc").value="";document.getElementById("newLessonVideo").value="";
    setMessage("lessonAdminMessage","تمت إضافة الدرس والفيديو بنجاح.","ok");refreshTeacherPanel();
  }catch(e){setMessage("lessonAdminMessage","تعذر حفظ الفيديو. ربما مساحة المتصفح غير كافية.","error")}
}
function renderAdminLessons(){
  const host=document.getElementById("adminLessonList");if(!host)return;
  const q=(document.getElementById("adminLessonSearch")?.value||"").trim().toLowerCase();
  const lessons=getLessons().sort((a,b)=>String(a.grade).localeCompare(String(b.grade))||a.order-b.order).filter(l=>(l.title+" "+gradeLabel(l.grade)).toLowerCase().includes(q));
  host.innerHTML=lessons.length?lessons.map(l=>`<div class="lesson"><div><b>${esc(l.title)}</b><div class="muted small">${gradeLabel(l.grade)} • الدرس ${l.order||1}</div></div><div class="admin-actions"><button class="btn alt" onclick="editLesson('${l.id}')">تعديل</button><button class="btn alt" onclick="moveLesson('${l.id}',-1)" title="رفع الدرس">↑</button><button class="btn alt" onclick="moveLesson('${l.id}',1)" title="خفض الدرس">↓</button><button class="btn red" onclick="removeLesson('${l.id}')">حذف</button></div></div>`).join(""):'<div class="empty">لا توجد دروس مطابقة للبحث.</div>';
}
/* تعديل عنوان الدرس ووصفه دون حذف الفيديو أو الامتحان */
function editLesson(id){
  const list=getLessons(),lesson=list.find(x=>x.id===id);if(!lesson)return;
  const title=prompt("عنوان الدرس:",lesson.title);if(title===null)return;
  const description=prompt("وصف الدرس:",lesson.description||"");if(description===null)return;
  if(!title.trim()){alert("عنوان الدرس لا يمكن أن يكون فارغاً.");return}
  lesson.title=title.trim();lesson.description=description.trim();writeDB(DB_KEYS.lessons,list);refreshTeacherPanel();
}
/* تغيير ترتيب الدروس داخل الصف */
function moveLesson(id,direction){
  const list=getLessons(),item=list.find(x=>x.id===id);if(!item)return;
  const same=list.filter(x=>x.grade===item.grade).sort((a,b)=>(a.order||0)-(b.order||0));
  const index=same.findIndex(x=>x.id===id),target=same[index+direction];if(!target)return;
  const old=item.order;item.order=target.order;target.order=old;writeDB(DB_KEYS.lessons,list);renderAdminLessons();
}
async function removeLesson(id){
  if(!confirm("هل تريد حذف الدرس والفيديو والامتحان المرتبط به؟"))return;
  await deleteVideo(id);writeDB(DB_KEYS.lessons,getLessons().filter(l=>l.id!==id));writeDB(DB_KEYS.exams,getExams().filter(e=>e.lessonId!==id));writeDB(DB_KEYS.progress,getProgress().filter(p=>p.lessonId!==id));refreshTeacherPanel();
}

/* إنشاء أسئلة الامتحان من لوحة المدرس */
function addQuestionEditor(){
  const n=questionEditorCount++;
  const div=document.createElement("div");div.className="question";div.dataset.question="1";
  div.innerHTML=`<b>السؤال ${n+1}</b><div class="field"><label>نص السؤال</label><input class="qtext" placeholder="اكتب السؤال هنا"></div><div class="grid">${[0,1,2,3].map(i=>`<div class="field"><label>الاختيار ${i+1}</label><input class="qoption" placeholder="الاختيار ${i+1}"></div>`).join("")}</div><div class="field"><label>الإجابة الصحيحة</label><select class="qanswer"><option value="0">الاختيار الأول</option><option value="1">الاختيار الثاني</option><option value="2">الاختيار الثالث</option><option value="3">الاختيار الرابع</option></select></div><button class="btn red" onclick="this.parentElement.remove()">حذف السؤال</button>`;
  document.getElementById("questionBuilder").appendChild(div);
}
function refreshExamLessonSelect(){
  const select=document.getElementById("examLesson");
  select.innerHTML=getLessons().map(l=>`<option value="${l.id}">${esc(l.title)} — ${gradeLabel(l.grade)}</option>`).join("");
}
function saveExam(){
  const lessonId=document.getElementById("examLesson").value;
  const title=document.getElementById("newExamTitle").value.trim();
  const blocks=[...document.querySelectorAll("#questionBuilder [data-question]")];
  if(!lessonId||!title||!blocks.length){setMessage("examAdminMessage","اختر درساً واكتب عنوان الامتحان وأضف سؤالاً واحداً على الأقل.","error");return}
  const questions=[];
  for(const b of blocks){
    const text=b.querySelector(".qtext").value.trim();
    const options=[...b.querySelectorAll(".qoption")].map(x=>x.value.trim());
    const answer=Number(b.querySelector(".qanswer").value);
    if(!text||options.some(x=>!x)){setMessage("examAdminMessage","أكمل نص كل سؤال والاختيارات الأربعة.","error");return}
    questions.push({text,options,answer});
  }
  const exams=getExams().filter(e=>e.lessonId!==lessonId);
  exams.push({id:uid(),lessonId,title,questions,createdAt:new Date().toISOString()});
  writeDB(DB_KEYS.exams,exams);document.getElementById("questionBuilder").innerHTML="";questionEditorCount=0;document.getElementById("newExamTitle").value="";
  setMessage("examAdminMessage","تم حفظ الامتحان بنجاح.","ok");
}

/* إدارة الطلاب: تعديل الدرجة وفتح الدرس وإعادة المحاولة */
function renderStudentsTable(){
  const allStudents=getStudents(),lessons=getLessons(),progress=getProgress(),host=document.getElementById("studentsTable");
  if(!allStudents.length){host.innerHTML='<div class="empty">لم يسجل أي طالب حتى الآن.</div>';return}
  const q=(document.getElementById("studentAdminSearch")?.value||"").trim().toLowerCase();
  const students=allStudents.filter(s=>(s.name+" "+(s.phone||s.identity||"")+" "+gradeLabel(s.grade)).toLowerCase().includes(q));
  const subs=readDB(DB_KEYS.subscriptions,[]);
  const rows=students.map(s=>{
    const sub=subs.find(x=>x.studentId===s.id);
    const active=!!(sub && (!sub.expiresAt || new Date(sub.expiresAt).getTime()>Date.now()));
    const status=active?(sub.type==="term"?"اشتراك ترم":"اشتراك شهري"):"بدون اشتراك";
    const details=active?(sub.type==="month"?` — ${sub.lessonLimit} حصص`:` — حتى ${new Date(sub.expiresAt).toLocaleDateString("ar-EG")}`):"";
    return `<tr><td>${esc(s.name)}</td><td dir="ltr">${esc(s.phone||s.identity)}</td><td>${gradeLabel(s.grade)}${s.stage==="prep"?`<div class="muted small">${s.schoolType==="language"?"مدارس لغات":"مدارس عربي"}</div>`:""}</td><td>${status}${details}</td><td><button class="btn goldbtn" onclick="grantSubscription('${s.id}')">تفعيل / تغيير الاشتراك</button> ${active?`<button class="btn red" onclick="cancelSubscription('${s.id}')">إلغاء الاشتراك</button>`:""} <button class="btn red" onclick="deleteStudentAccount('${s.id}')">حذف الحساب</button></td></tr>`;
  });
  if(!students.length){host.innerHTML='<div class="empty">لا يوجد طالب مطابق للبحث.</div>';return}
  host.innerHTML=`<h3>إدارة اشتراكات الطلاب</h3><p class="muted small">يمكنك تفعيل اشتراك شهري بعدد حصص محدد أو اشتراك ترم، كما يمكنك إلغاء أي اشتراك في أي وقت.</p><div class="tablewrap"><table><thead><tr><th>الطالب</th><th>رقم الهاتف</th><th>الصف</th><th>حالة الاشتراك</th><th>إدارة الاشتراك</th></tr></thead><tbody>${rows.join("")}</tbody></table></div><hr><h3>متابعة الدرجات وفتح الدروس</h3><div class="tablewrap"><table><thead><tr><th>الطالب</th><th>الدرس</th><th>الدرجة</th><th>الحالة</th><th>إجراءات</th></tr></thead><tbody>${students.flatMap(s=>lessons.filter(l=>l.grade===s.grade).map(l=>{const p=progress.find(x=>x.studentId===s.id&&x.lessonId===l.id);return `<tr><td>${esc(s.name)}</td><td>${esc(l.title)}</td><td>${p?(p.lastScore??p.score)+"%":"لم يمتحن"}</td><td>${p?.teacherUnlocked?"مفتوح بواسطة المدرس":p?.score>=50?"اجتاز":"مغلق"}</td><td><button class="btn alt" onclick="editStudentScore('${s.id}','${l.id}')">تعديل الدرجة</button> <button class="btn green" onclick="teacherUnlock('${s.id}','${l.id}')">فتح الدرس</button> <button class="btn" onclick="allowRetake('${s.id}','${l.id}')">إعادة الامتحان</button></td></tr>`})).join("")}</tbody></table></div>`;
}

/* إعداد وتصميم محمود أبوزايد: حذف حساب الطالب وبياناته التابعة من هذا المتصفح */
function deleteStudentAccount(studentId){
  const session=currentSession();
  if(!session || session.role!=="teacher"){
    alert("حذف الحساب متاح للمدرس فقط.");
    return;
  }
  const student=getStudents().find(s=>s.id===studentId);
  if(!student){alert("هذا الحساب غير موجود.");return}
  if(!confirm(`تحذير: سيتم حذف حساب الطالب "${student.name}" ونتائجه واشتراكه نهائياً من بيانات هذا المتصفح. هل تريد المتابعة؟`))return;

  writeDB(DB_KEYS.students,getStudents().filter(s=>s.id!==studentId));
  saveProgress(getProgress().filter(p=>p.studentId!==studentId));
  writeDB(DB_KEYS.subscriptions,readDB(DB_KEYS.subscriptions,[]).filter(s=>s.studentId!==studentId));
  if(currentSession()?.studentId===studentId)localStorage.removeItem(DB_KEYS.session);

  renderStudentsTable();
  alert("تم حذف حساب الطالب ونتائجه واشتراكه من هذا المتصفح.");
}

/* إعداد وتصميم محمود أبوزايد: المدرس يختار نوع الاشتراك ويدير إلغاءه */
function grantSubscription(studentId){
  const choice=prompt("اختر نوع الاشتراك بكتابة الرقم:\\n1 - اشتراك شهري (بعدد حصص تحدده)\\n2 - اشتراك ترم (كل دروس الترم)","1");
  if(choice===null)return;
  const type=choice.trim()==="1"?"month":choice.trim()==="2"?"term":null;
  if(!type){alert("اختيار غير صحيح. اكتب 1 للشهري أو 2 للترم.");return}
  let lessonLimit=0,expiresAt;
  if(type==="month"){
    lessonLimit=Number(prompt("حدد عدد الحصص المسموح بها في الاشتراك الشهري:","8"));
    if(!Number.isInteger(lessonLimit)||lessonLimit<1){alert("اكتب عدد حصص صحيحاً أكبر من صفر.");return}
    expiresAt=new Date(Date.now()+30*24*60*60*1000).toISOString();
  }else{
    const date=prompt("اكتب تاريخ نهاية الترم بصيغة YYYY-MM-DD. اتركه فارغاً لمدة 120 يوماً:","");
    expiresAt=date.trim()?new Date(date.trim()+"T23:59:59").toISOString():new Date(Date.now()+120*24*60*60*1000).toISOString();
    if(Number.isNaN(new Date(expiresAt).getTime())){alert("تاريخ غير صحيح.");return}
  }
  const subs=readDB(DB_KEYS.subscriptions,[]).filter(s=>s.studentId!==studentId);
  subs.push({studentId,type,lessonLimit,expiresAt,activatedAt:new Date().toISOString(),cancelled:false});
  writeDB(DB_KEYS.subscriptions,subs);
  renderStudentsTable();
  alert(type==="month"?"تم تفعيل الاشتراك الشهري للطالب.":"تم تفعيل اشتراك الترم وفتح دروس الترم للطالب.");
}
function cancelSubscription(studentId){
  if(!confirm("هل أنت متأكد من إلغاء اشتراك هذا الطالب الآن؟ سيتم إغلاق الدروس المدفوعة فوراً."))return;
  const subs=readDB(DB_KEYS.subscriptions,[]);
  const sub=subs.find(s=>s.studentId===studentId);
  if(!sub){alert("لا يوجد اشتراك لهذا الطالب.");return}
  sub.cancelled=true;
  sub.cancelledAt=new Date().toISOString();
  sub.expiresAt=new Date().toISOString();
  writeDB(DB_KEYS.subscriptions,subs);
  renderStudentsTable();
  alert("تم إلغاء الاشتراك. يمكنك تفعيله مرة أخرى في أي وقت.");
}
function editStudentScore(studentId,lessonId){
  if(currentSession()?.role!=="teacher"){alert("هذه الصلاحية للمدرس فقط.");return}
  const p=getProgress();let item=p.find(x=>x.studentId===studentId&&x.lessonId===lessonId);
  const current=item?.score??0;const value=prompt("اكتب الدرجة الجديدة من 0 إلى 100:",current);
  if(value===null)return;const score=Number(value);
  if(!Number.isFinite(score)||score<0||score>100){alert("الدرجة يجب أن تكون بين 0 و100.");return}
  if(!item){item={studentId,lessonId,score,attempts:0,teacherUnlocked:false};p.push(item)}
  item.score=score;item.lastScore=score;item.teacherEdited=true;saveProgress(p);renderStudentsTable();
}
function teacherUnlock(studentId,lessonId){
  if(currentSession()?.role!=="teacher"){alert("هذه الصلاحية للمدرس فقط.");return}
  const p=getProgress();let item=p.find(x=>x.studentId===studentId&&x.lessonId===lessonId);
  if(!item){item={studentId,lessonId,score:0,attempts:0,teacherUnlocked:true};p.push(item)}else item.teacherUnlocked=true;
  saveProgress(p);renderStudentsTable();alert("تم فتح الدرس لهذا الطالب.");
}
function allowRetake(studentId,lessonId){
  if(currentSession()?.role!=="teacher"){alert("هذه الصلاحية للمدرس فقط.");return}
  const p=getProgress();let item=p.find(x=>x.studentId===studentId&&x.lessonId===lessonId);
  if(!item){item={studentId,lessonId,score:0,attempts:0,teacherUnlocked:false};p.push(item)}
  item.allowRetake=true;item.teacherUnlocked=true;saveProgress(p);renderStudentsTable();alert("تم السماح للطالب بإعادة الامتحان وفتح الدرس.");
}

/* إعداد وتصميم محمود أبوزايد: تصدير واستيراد نسخة احتياطية من بيانات المنصة */
function exportAcademyData(){
  const backup={app:"AlGawish Academy",version:1,exportedAt:new Date().toISOString(),students:getStudents(),lessons:getLessons(),exams:getExams(),progress:getProgress(),subscriptions:readDB(DB_KEYS.subscriptions,[])};
  const blob=new Blob([JSON.stringify(backup,null,2)],{type:"application/json"});
  const url=URL.createObjectURL(blob),a=document.createElement("a");a.href=url;a.download="AlGawish_Academy_Backup.json";a.click();URL.revokeObjectURL(url);
}
async function importAcademyData(event){
  const file=event.target.files?.[0];if(!file)return;
  try{
    const data=JSON.parse(await file.text());
    if(data.app!=="AlGawish Academy"||!Array.isArray(data.students)||!Array.isArray(data.lessons)||!Array.isArray(data.exams))throw new Error("invalid");
    if(!confirm("سيتم استبدال بيانات الطلاب والدروس والامتحانات والدرجات والاشتراكات الحالية. هل تريد المتابعة؟"))return;
    writeDB(DB_KEYS.students,data.students);writeDB(DB_KEYS.lessons,data.lessons);writeDB(DB_KEYS.exams,data.exams);writeDB(DB_KEYS.progress,Array.isArray(data.progress)?data.progress:[]);writeDB(DB_KEYS.subscriptions,Array.isArray(data.subscriptions)?data.subscriptions:[]);
    refreshTeacherPanel();alert("تم استيراد البيانات بنجاح. تذكّر أن ملفات الفيديو لا تنتقل ضمن هذه النسخة.");
  }catch(e){alert("ملف النسخة الاحتياطية غير صالح أو غير متوافق.");}
  finally{event.target.value="";}
}

/* إعداد وتصميم محمود أبوزايد: تبديل الوضع الليلي وحفظ اختيار المستخدم */
function toggleTheme(){
  document.body.classList.toggle("dark-mode");
  const dark=document.body.classList.contains("dark-mode");
  localStorage.setItem("mg_dark_mode",dark?"1":"0");
  document.getElementById("themeBtn").textContent=dark?"☀️ الوضع النهاري":"🌙 الوضع الليلي";
}
function loadTheme(){
  const dark=localStorage.getItem("mg_dark_mode")==="1";
  document.body.classList.toggle("dark-mode",dark);
  const btn=document.getElementById("themeBtn");
  if(btn)btn.textContent=dark?"☀️ الوضع النهاري":"🌙 الوضع الليلي";
}
/* تغيير لغة واجهة الموقع بين العربية والإنجليزية */
function toggleLanguage(){
  language=language==="ar"?"en":"ar";
  document.documentElement.lang=language;document.documentElement.dir=language==="ar"?"rtl":"ltr";
  document.getElementById("langBtn").textContent=language==="ar"?"English":"العربية";
  document.querySelectorAll("[data-ar][data-en]").forEach(el=>el.textContent=el.getAttribute("data-"+language));
}

/* بدء الصفحة: تجهيز التاريخ والتحقق من الجلسة المحلية */
document.getElementById("year").textContent=new Date().getFullYear();
loadTheme();
(function init(){
  const session=currentSession();
  if(session?.role==="teacher"){refreshTeacherPanel();showView("teacherView")}
  else if(session?.role==="student"&&getStudents().some(s=>s.id===session.studentId)){openGrade("sec1")}
  else{goHome()}
})();
</script>
