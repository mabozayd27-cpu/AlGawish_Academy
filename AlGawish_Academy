/* كلمة مرور المدرس: وضعت كما طلب صاحب المشروع.
   تنبيه أمني: أي كلمة مرور داخل HTML يمكن رؤيتها من مصدر الصفحة،
   لذلك لا تستخدم هذا الملف وحده كمنصة عامة على الإنترنت. */
const TEACHER_PASSWORD = "112233445566778899";

/* أسماء مفاتيح التخزين المحلي للطلاب والدروس والامتحانات والنتائج */
const DB_KEYS = {students:"mg_students_v1", lessons:"mg_lessons_v1", exams:"mg_exams_v1", progress:"mg_progress_v1", subscriptions:"mg_subscriptions_v1", session:"mg_session_v1"};
let currentGrade = 1;
let currentLessonId = null;
let currentExam = null;
let language = "ar";
let questionEditorCount = 0;
let activeLessonFilter = "all";

/* أدوات مساعدة للتعامل مع التخزين المحلي */
function readDB(key, fallback=[]){try{return JSON.parse(localStorage.getItem(key)) ?? fallback}catch(e){return fallback}}
function writeDB(key,value){localStorage.setItem(key,JSON.stringify(value))}
function getStudents(){return readDB(DB_KEYS.students)}
function getLessons(){return readDB(DB_KEYS.lessons)}
function getExams(){return readDB(DB_KEYS.exams)}
function getProgress(){return readDB(DB_KEYS.progress)}
function saveProgress(list){writeDB(DB_KEYS.progress,list)}
function uid(){return Date.now().toString(36)+Math.random().toString(36).slice(2,9)}
function esc(s){return String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
function currentSession(){return readDB(DB_KEYS.session,null)}
function setMessage(id,text,type=""){const el=document.getElementById(id);if(el)el.innerHTML=text?`<div class="notice ${type}">${esc(text)}</div>`:""}

/* نظام IndexedDB لحفظ ملفات الفيديو محلياً حتى بعد إغلاق الصفحة */
let videoDBPromise = new Promise((resolve,reject)=>{
  const req=indexedDB.open("MerfatEnglishVideoFiles",1);
  req.onupgradeneeded=()=>{const db=req.result;if(!db.objectStoreNames.contains("videos"))db.createObjectStore("videos")};
  req.onsuccess=()=>resolve(req.result);req.onerror=()=>reject(req.error);
});
async function saveVideo(file,id){
  const db=await videoDBPromise;
  return new Promise((resolve,reject)=>{const tx=db.transaction("videos","readwrite");tx.objectStore("videos").put(file,id);tx.oncomplete=()=>resolve(true);tx.onerror=()=>reject(tx.error)});
}
async function getVideo(id){
  const db=await videoDBPromise;
  return new Promise((resolve,reject)=>{const tx=db.transaction("videos","readonly");const req=tx.objectStore("videos").get(id);req.onsuccess=()=>resolve(req.result||null);req.onerror=()=>reject(req.error)});
}
async function deleteVideo(id){
  const db=await videoDBPromise;
  return new Promise((resolve,reject)=>{const tx=db.transaction("videos","readwrite");tx.objectStore("videos").delete(id);tx.oncomplete=()=>resolve(true);tx.onerror=()=>reject(tx.error)});
}

