.grid{gap:16px}.feature-card{border-radius:22px}.btn{border-radius:13px;min-height:42px}.field input,.field select,.field textarea{border-radius:13px;min-height:44px}
.grade{position:relative;overflow:hidden;min-height:170px}.grade:after{content:"";position:absolute;left:18px;bottom:-34px;width:92px;height:92px;border:1px solid #315bd815;border-radius:26px;transform:rotate(28deg);box-shadow:0 0 0 12px #315bd808}
