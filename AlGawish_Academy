/* عرض امتحان الدرس وأسئلته */
function openExam(){openExamFor(currentLessonId)}
function openExamFor(lessonId){
  const exam=getExams().find(e=>e.lessonId===lessonId);
  if(!exam){alert("لا يوجد امتحان لهذا الدرس بعد.");return}
  const session=currentSession();
  const lesson=getLessons().find(l=>l.id===lessonId);
  if(!isUnlocked(session?.studentId,lesson)){alert("الدرس مغلق.");return}
  currentLessonId=lessonId;currentExam=exam;

  const progress=getProgress();
  let record=progress.find(x=>x.studentId===session.studentId&&x.lessonId===lessonId);
  const reviewOnly=!!(record?.examSubmitted && !record?.allowRetake);

  // لو المدرس سمح بمحاولة جديدة، نحفظ المحاولة السابقة في السجل ثم نستهلك الإذن.
  if(record?.allowRetake){
    record.attemptHistory=record.attemptHistory||[];
    if(record.examSubmitted){
      record.attemptHistory.push({
        score:record.lastScore??record.score,
        answers:record.savedAnswers||[],
        submittedAt:record.updatedAt||new Date().toISOString()
      });
    }
    record.allowRetake=false;
    record.examSubmitted=false;
    record.savedAnswers=[];
    saveProgress(progress);
  }

  document.getElementById("examTitle").textContent=exam.title+(reviewOnly?" — مراجعة المحاولة السابقة":"");
  document.getElementById("examFinalResult").innerHTML="";
  document.getElementById("examFinalResult").classList.add("hidden");
  document.getElementById("submitExamBtn").classList.toggle("hidden",reviewOnly);
  document.getElementById("submitExamBtn").disabled=false;
  examLockedAnswers={};

  const saved=reviewOnly?(record.savedAnswers||[]):[];
  document.getElementById("examQuestions").innerHTML=exam.questions.map((q,i)=>{
    const selected=Number(saved[i]);
    const correct=Number(q.answer);
    if(reviewOnly){
      const chosen=Number.isInteger(selected)?selected:-1;
      const feedback=chosen===correct
        ?'<div class="answer-feedback feedback-correct">✓ إجابتك صحيحة.</div>'
        :`<div class="answer-feedback feedback-wrong">✗ إجابتك خاطئة. الإجابة الصحيحة: ${esc(q.options[correct])}</div>`;
      return `<div class="question"><b>${i+1}. ${esc(q.text)}</b>${feedback}${q.options.map((o,j)=>`<div class="option ${j===correct?"answer-correct":""} ${j===chosen&&chosen!==correct?"answer-wrong":""}">${esc(o)} ${j===chosen?"— إجابتك":""}</div>`).join("")}</div>`;
    }
    return `<div class="question" id="question_${i}"><b>${i+1}. ${esc(q.text)}</b><div class="answer-feedback" id="feedback_${i}" aria-live="polite"></div>${q.options.map((o,j)=>`<label class="option" id="option_${i}_${j}"><input type="radio" name="answer_${i}" value="${j}" onchange="lockExamAnswer(${i},${j})"> ${esc(o)}</label>`).join("")}</div>`;
  }).join("");

  if(reviewOnly){
    const score=record.lastScore??record.score??0;
    const result=document.getElementById("examFinalResult");
    result.classList.remove("hidden");
    result.innerHTML=`<div class="exam-result-content"><h2>مراجعة نتيجتك السابقة</h2><div class="result-score">${score}%</div><p>تم حفظ نتيجتك. لا يمكن إعادة هذا الامتحان إلا بإذن المعلمة.</p><div class="notice ok">يمكنك مراجعة إجاباتك فقط. الدرجة المسجلة لن تتغير.</div><button class="btn alt" onclick="backToGrade()">العودة إلى الدروس</button></div>`;
  }
  showView("examView");
}
/* إعداد وتصميم محمود أبوزايد: تثبيت إجابة الطالب فور اختيارها */
let examLockedAnswers={};

function lockExamAnswer(questionIndex, selectedIndex){
  if(!currentExam || Object.prototype.hasOwnProperty.call(examLockedAnswers,questionIndex))return;
  const question=currentExam.questions[questionIndex];
  if(!question)return;
  examLockedAnswers[questionIndex]=selectedIndex;
  const correctIndex=Number(question.answer);

  question.options.forEach((option,index)=>{
    const input=document.querySelector(`input[name="answer_${questionIndex}"][value="${index}"]`);
    const label=document.getElementById(`option_${questionIndex}_${index}`);
    if(input)input.disabled=true;
    if(label){
      if(index===correctIndex)label.classList.add("answer-correct");
      if(index===selectedIndex && selectedIndex!==correctIndex)label.classList.add("answer-wrong");
    }
  });

  const feedback=document.getElementById(`feedback_${questionIndex}`);
  if(feedback){
    feedback.textContent=selectedIndex===correctIndex
      ?"✓ إجابة صحيحة! أحسنت."
      :`✗ إجابة غير صحيحة. الإجابة الصحيحة هي: ${question.options[correctIndex]}`;
    feedback.className="answer-feedback "+(selectedIndex===correctIndex?"feedback-correct":"feedback-wrong");
  }
}

function submitExam(){
  if(!currentExam)return;
  const session=currentSession();
  if(!session || session.role!=="student"){alert("هذه العملية متاحة للطالب المسجل فقط.");return}
  const progressCheck=getProgress();
  const alreadySubmitted=progressCheck.find(x=>x.studentId===session.studentId&&x.lessonId===currentLessonId);
  if(alreadySubmitted?.examSubmitted && !alreadySubmitted?.allowRetake){
    alert("لقد سلمت هذا الامتحان من قبل. يمكنك مراجعة إجاباتك فقط.");
    openExamFor(currentLessonId);
    return;
  }
  const total=currentExam.questions.length;
  const answered=Object.keys(examLockedAnswers).length;
  if(answered<total){
    alert(`أجب عن جميع الأسئلة أولاً. أجبت عن ${answered} من ${total} سؤال.`);
    return;
  }

  const answers=currentExam.questions.map((q,i)=>examLockedAnswers[i]??-1);
  const correct=currentExam.questions.reduce((n,q,i)=>n+(answers[i]===Number(q.answer)?1:0),0);
  const score=total?Math.round(correct/total*100):0;
  const studentId=session.studentId;
  const progress=getProgress();let p=progress.find(x=>x.studentId===studentId&&x.lessonId===currentLessonId);
  if(!p){p={studentId,lessonId:currentLessonId,score:0,teacherUnlocked:false,attempts:0};progress.push(p)}
  p.score=Math.max(p.score,score);
  p.lastScore=score;
  p.savedAnswers=answers.slice();
  p.examSubmitted=true;
  p.allowRetake=false;
  p.attempts=(p.attempts||0)+1;
  p.updatedAt=new Date().toISOString();
  saveProgress(progress);
  const pass=score>=50||p.teacherUnlocked;
  const whatsapp="https://wa.me/201201317526?text="+encodeURIComponent("مرحباً، اريد الاشتراك في AlGawish Academy التعليمية");
  const result=document.getElementById("examFinalResult");
  result.classList.remove("hidden");
  result.innerHTML=`<div class="exam-result-content">
    <div class="result-icon">${pass?"🏆":"📚"}</div>
    <h2>${pass?"أحسنت! اجتزت الامتحان":"حاول مرة أخرى، أنت تستطيع"}</h2>
    <div class="result-score">${score}%</div>
    <p>${pass?"نتيجتك 50% أو أكثر، وتم تسجيل اجتيازك وفتح الدرس التالي حسب ترتيب المنهج.":"درجتك أقل من 50%، لذلك سيظل الدرس التالي مغلقاً حتى تسمح لك المعلمة بإعادة الامتحان أو تفتح الدرس."}</p>
    <p class="muted">الإجابات الصحيحة: ${correct} من ${total}</p>
    ${pass?'<div class="notice ok">تم حفظ نتيجتك بنجاح. استمر في التعلم والتقدم! 🌟</div>':'<div class="notice error">للمساعدة أو الاستفسار تواصل مع مسؤول الاشتراكات.</div><a class="btn goldbtn" target="_blank" rel="noopener" href="'+whatsapp+'">تواصل مع المسؤول عبر واتساب</a>'}
    <div style="margin-top:16px"><button class="btn alt" onclick="backToGrade()">العودة إلى الدروس</button></div>
  </div>`;
  document.getElementById("submitExamBtn").disabled=true;
  result.scrollIntoView({behavior:"smooth",block:"start"});
}

