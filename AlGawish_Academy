/* التحقق من صلاحية الطالب والدرس السابق */
function hasPassed(studentId,lesson){
  const p=getProgress().find(x=>x.studentId===studentId&&x.lessonId===lesson.id);
  return !!(p&&(p.score>=50||p.teacherUnlocked));
}
function activeSubscription(studentId){
  const subs=readDB(DB_KEYS.subscriptions,[]);
  const sub=subs.find(s=>s.studentId===studentId);
  if(!sub || sub.cancelled)return null;
  if(sub.expiresAt && new Date(sub.expiresAt).getTime()<Date.now())return null;
  return sub;
}
function isUnlocked(studentId,lesson){
  if(!studentId)return false;
  const lessons=getLessons().filter(l=>l.grade===lesson.grade).sort((a,b)=>a.order-b.order);
  const index=lessons.findIndex(l=>l.id===lesson.id);
  if(index===0)return true; // أول درس تعريفي مجاني دائماً
  const sub=activeSubscription(studentId);
  const progress=getProgress().find(x=>x.studentId===studentId&&x.lessonId===lesson.id);
  if(progress?.teacherUnlocked)return true; // المدرس يستطيع فتح أي درس يدوياً
  if(!sub)return false; // لا توجد دروس مدفوعة دون اشتراك
  if(sub.type==="month" && index>=(Number(sub.lessonLimit)||0)+1)return false;
  // بعد تفعيل الاشتراك يظل شرط اجتياز امتحان الدرس السابق قائماً
  return hasPassed(studentId,lessons[index-1]);
}
function gradeLabel(key){
  return ({prep1:"أولى إعدادي",prep2:"تانية إعدادي",prep3:"تالتة إعدادي",sec1:"أولى ثانوي",sec2:"تانية ثانوي",sec3:"تالتة ثانوي"})[key]||key;
}
